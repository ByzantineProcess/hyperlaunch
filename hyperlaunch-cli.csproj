<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Hyperlaunch</RootNamespace>
    <AssemblyName>hyperlaunch-cli</AssemblyName>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- <PublishReadyToRun>false</PublishReadyToRun> -->
    <!-- <SelfContained>false</SelfContained> -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Exclude the Godot GUI entry point -->
    <Compile Remove="Main.cs" />
    <!-- Exclude everything under godot-gui/ -->
    <Compile Remove="godot-gui\**\*.cs" />
    
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.81.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.81.0" />
  </ItemGroup>
</Project>
